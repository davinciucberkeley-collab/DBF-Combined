# compiled helper tools (rebuild with cad/build.ps1) and vendor interop assemblies
*.exe
*.dll
*.pdb
# SOLIDWORKS lock/temp files and solver logs
~$*
*.SLDBAK
cad/sim/*BenchMark-Solver.txt
cad/sim/PerformanceLog.txt
# local tooling
.claude/
__pycache__/
node_modules/

# third-party downloads
*.pdf
# SOLIDWORKS Simulation result databases (regenerate with cad/Sim.exe; studies are saved inside cad/sim/*.SLDPRT)
cad/sim/*.CWR
cad/sim/*.gsz
cad/sim/*.LOG
cad/sim/*.HTQ

# Impeccable detector snapshots (local before/after comparisons)
before.json
after.json

# JPEG copies of the renders: build.mjs regenerates them on Windows; the four the page embeds are committed
# so a runner without the converter (CI) builds the same page
review/img/*
!review/img/VTOL_Concept_iso.jpg
!review/img/FEA_Boom_vonMises.jpg
!review/img/FEA_Spar_vonMises.jpg
!review/img/THERM_Motor_steady.jpg

# the drawing set PDF is a deliverable
!cad/drawings/DBF-DRW-001.PDF
review/_preview/

# downloaded ArduPilot parameter metadata (check_params.py fetches it again)
firmware/tools/cache/
# SOLIDWORKS thermal result databases (regenerate with cad/Thermal.exe; studies are saved in cad/sim/thermal/*.SLDPRT)
cad/sim/thermal/*.CWR
cad/sim/thermal/*.HTQ
cad/sim/thermal/*.HTO
cad/sim/thermal/*.P42
cad/sim/thermal/*.gsz
cad/sim/thermal/*.MAS
cad/sim/thermal/*.LOG
cad/sim/thermal/PerformanceLog.txt
cad/sim/thermal/PROBE_*
# exported thermal fields (5-8 MB each; the page uses the downsampled copy in analysis/thermal/thermal_results.json)
cad/sim/thermal/fields/
# exported FEA fields (14-22 MB; the page uses analysis/fea_fields.json)
cad/sim/fields/

# Blender renders (regenerated by docs/figures/render_steps.py / render_scenes.py; the annotated SVGs that embed them are committed)
docs/figures/renders/
# SITL run artefacts (results_c0.json and the scenario CSVs are the committed record)
firmware/sitl/results_c0/eeprom.bin
firmware/sitl/results_c0/logs/
firmware/sitl/results_c0/terrain/
firmware/sitl/results_c0/physics_log.csv
firmware/sitl/results_c0/*.log

# ---------------------------------------------------------------- DBF-Combined additions (2026-11-08)
# Secrets: never commit API keys or tokens (the team's Claude API key included). Keep them in an env file or the
# OS keychain; .env.example (no real values) may be committed.
.env
.env.*
!.env.example
*.env
secrets.*
*.pem
.secrets/

# Generated duplicates. review/build.mjs and inventory/build_overview.mjs also write these fragment copies for
# publishing as claude.ai artifacts; the canonical committed pages are the standalone copies at the repo root
# (VTOL-Review.html, build-manual.html, test-plan.html, flight-software.html, templates.html, Inventory-Overview.html).
review/vtol-review.html
review/build-manual.html
review/test-plan.html
review/flight-software.html
review/templates.html
inventory/inventory-overview.html

# Solver and build logs. The few logs the validation matrix cites as evidence are tracked already; to record a new
# one on purpose use `git add -f`. SU2 per-case logs are kept (analysis/cfd3d/out/.gitignore keeps solver logs).
*.log
!su2.log
!docs/test/analysis/sample/flight_sample.log

# Python / Node / editor caches and build outputs
*.pyc
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/
tools/opencae-studio/build/
tools/opencae-studio/dist/

# OpenCAE Studio: solver runs inside example projects are regenerated by opencae/examples/build_examples.py
tools/opencae-studio/opencae/examples/projects/*_data/results/

# OS clutter
Thumbs.db
desktop.ini
.DS_Store

# collision check scratch (collision/collide.py regenerates it)
redesign/collision/out/_job.json
redesign/collision/out/blender.log
