  {
   "id": "ASM-B1V-CFD-2D",
   "type": "assumption",
   "title": "Fin drag from 2-D section RANS",
   "text": "Each fin's zero-lift drag is the SU2 2-D section Cd (fully turbulent SA, 16 m/s) times its chord, over the tube length for the tube + board section and over the rest of the fin height for the bare board; the rev 3 interference factor 1.15 is kept on top for the root and tip junctions",
   "basis": "the board edges are square (laser- or knife-cut foam board, fins SPEC) and trip the boundary layer, so fully turbulent SA is the right model on the fins; tip and root 3-D effects are small at h/c 0.76 per half-fin and stay inside the 1.15 factor; 3 mm epoxy fillet at the tube-board joint (fins.fin.le_gap_m filled), board edges sharp. Re 3.0e5",
   "value": [
    1.15
   ],
   "unit": "-",
   "status": "PROPOSED",
   "cites": [
    "SRC-B1-SIM-CFD"
   ]
  },
