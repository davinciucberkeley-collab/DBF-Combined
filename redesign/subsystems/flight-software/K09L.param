# K09-L quad tailsitter - ArduPilot Plane parameter file (owner F4, revision F4-R1, 2026-11-09)
# Status: PROPOSED. Not loaded on hardware, not run in SITL (SITL not installed): UNVERIFIED.
# Firmware: ArduPlane stable with tailsitter support (R-FC-STABLE; board chosen by F3).
# Parameter names checked 2026-11-09 against ArduPilot master source and the Plane parameter index
#   (ArduPlane/quadplane.cpp, tailsitter.cpp, Parameters.cpp, AP_Vehicle/AP_FixedWing.h,
#    AP_Motors/AP_MotorsMulticopter.cpp, AC_WPNav/AC_WPNav.cpp). Before loading on the installed
#    stable build, run the name check in subsystems/flight-software/SITL-PLAN.md S1 (R-FSW-PARAMS).
# Two lines are deliberately duplicated under a legacy name (cm/s units in older builds): the loader
#   skips the name the installed build does not know. Marked LEGACY.
# Format: one comment line (or more) above every parameter, then NAME,VALUE. "(default)" marks a line
#   that repeats the firmware default on purpose because a forwarded request names it.
# Frame: params.json#frame (x aft, y right, z up, cruise attitude). Hover copter frame: forward = belly
#   (-z), right = right wing (+y), down = tail (+x). Motor map: subsystems/flight-software/SPEC.md.
# Re-check: python -I redesign/team/F4/fsw_check.py

# ---------------------------------------------------------------- 1 Frame: copter-motor tailsitter
# enable the QuadPlane VTOL code (reboot after setting)
Q_ENABLE,1
# tailsitter: hover nose-up on the same four motors; 1 = enabled with Q_ modes (2 = always, not used)
Q_TAILSIT_ENABLE,1
# copter frame class Quad (default, stated: R-FSW-PARAMS)
Q_FRAME_CLASS,1
# copter frame type X (default, stated). Not 17 NYT_X: elevons have no hover authority (CR-B4-06e), hover yaw is motor torque + 3 deg cant
Q_FRAME_TYPE,1
# all four motors stay active in fixed-wing flight (bitmask motors 1-4): they are the cruise propulsion
Q_TAILSIT_MOTMX,15
# 262400 = bit 18 ARMVTOL (arm only in a Q mode, J1 failure mode 8) + bit 8 Mtrs_Only_Qassist (assist uses motors, elevons stay plane-controlled). Bit 5 off: RC loss in a Q mode -> QLAND
Q_OPTIONS,262400
# start in QSTABILIZE, never MANUAL (default MANUAL would pass raw sticks to a hovering tailsitter)
INITIAL_MODE,17

# ---------------------------------------------------------------- 2 Outputs (FC ports: F3 confirms timer groups; F2 writes signal.fc_port)
# out 1 = Motor 1 = station LR (lower right), CCW seen from the nose (11x5.5MR)
SERVO1_FUNCTION,33
# out 2 = Motor 2 = station UL (upper left), CCW seen from the nose (11x5.5MR)
SERVO2_FUNCTION,34
# out 3 = Motor 3 = station LL (lower left), CW seen from the nose (11x5.5MRP)
SERVO3_FUNCTION,35
# out 4 = Motor 4 = station UR (upper right), CW seen from the nose (11x5.5MRP)
SERVO4_FUNCTION,36
# out 5 = left elevon servo MEC-001-L (ElevonLeft); direction, trim and +/-25 deg throw set on the bench (SERVO5_MIN/MAX/TRIM/REVERSED)
SERVO5_FUNCTION,77
# out 6 = right elevon servo MEC-001-R (ElevonRight)
SERVO6_FUNCTION,78
# motor outputs DShot300 (Bluejay reflash of the LANRC BLHeli_S ESC, E1); needs a bdshot firmware build for the board
Q_M_PWM_TYPE,5
# bidirectional DShot on outputs 1-4 for ESC rpm telemetry (harmonic notch, rpm cap check)
SERVO_BLH_BDMASK,15
# motor magnet poles for rpm = eRPM / (poles/2); X3108S 12N14P (UNVERIFIED: count the magnets)
SERVO_BLH_POLES,14
# ESC type for DShot commands: 1 = BLHeli32/BLHeli_S/Kiss family (UNVERIFIED for Bluejay; bench check)
SERVO_DSHOT_ESC,1

# ---------------------------------------------------------------- 3 Motor limits (E1, B4, C1)
# output at full demand: holds rpm <= 9 350 on a 16.8 V pack (CL-B4-SPIN-MAX 0.849). Documented range is 0.9-1.0: SITL S1 confirms the value is kept; the stand (T-F4-RPM-CAP) confirms rpm with ESC telemetry
Q_M_SPIN_MAX,0.84
# pack-current limiter 100 A (CR-E1-08, R-ESC-CURRENT a)
Q_M_BAT_CURR_MAX,100
# limiter time constant 1 s (default 5 s): C1 shows a step to full throttle outruns a slow limiter (CL-C1-T-CAP)
Q_M_BAT_CURR_TC,1
# voltage compensation range, 4S full / empty (CR-E1-08)
Q_M_BAT_VOLT_MAX,16.8
# 3.30 V/cell
Q_M_BAT_VOLT_MIN,13.2
# hover throttle start value (E1: duty 0.49 on the 11x5.5MR); learnt in flight (Q_M_HOVER_LEARN 2, default)
Q_M_THST_HOVER,0.49
# fixed-wing throttle ceiling 75 %: FW motor output bypasses Q_M_SPIN_MAX; 0.75 + 0.0875 yaw differential = 0.84 (CL-F4-FW-ACT-MAX)
THR_MAX,75
# fixed-wing throttle floor 10 %: keeps differential-thrust yaw authority when TECS idles (CR-B3-04)
THR_MIN,10

# ---------------------------------------------------------------- 4 Hover (Q modes)
# hover lean limit 30 deg (default, stated): 5 m/s lean 15 deg (CL-B1-LEAN-5MS), tip-over 30.6 deg (CL-A1-TIPOVER)
Q_A_ANGLE_MAX,30
# hover body-rate limits (deg/s): <= 3 rad/s = 172 deg/s assumed by C1 (CR-C1-08)
Q_A_RATE_R_MAX,120
# copter pitch = upper vs lower pair
Q_A_RATE_P_MAX,120
# copter yaw = plane roll about the thrust axis; slowest axis (torque + cant)
Q_A_RATE_Y_MAX,90
# starting rate gains (PROPOSED; tuned per TUNING-PLAN.md). Copter roll = left/right pairs, arm 0.32 m
Q_A_RAT_RLL_P,0.08
Q_A_RAT_RLL_I,0.08
Q_A_RAT_RLL_D,0.002
# copter pitch = upper/lower pairs, arm 0.19 m
Q_A_RAT_PIT_P,0.08
Q_A_RAT_PIT_I,0.08
Q_A_RAT_PIT_D,0.002
# copter yaw: reaction torque + 3 deg cant (CL-B4-YAW-CANT 1.65)
Q_A_RAT_YAW_P,0.40
Q_A_RAT_YAW_I,0.04
# auto/QRTL descent 1.2 m/s: vortex-ring onset 1.88 m/s (CL-B4-DESCENT); B4 asks <= 1.5 (CR-B4-06b). Units m/s
Q_WP_SPD_DN,1.2
# LEGACY name of the line above (cm/s), older stable builds
Q_WP_SPEED_DN,120
# pilot descent in QHOVER/QLOITER 1.2 m/s (default 0 = uses the 2.5 m/s climb limit, above VRS onset)
Q_PILOT_SPD_DN,1.2
# LEGACY name of the line above (cm/s)
Q_PILOT_SPEED_DN,120
# final landing descent 0.5 m/s (default, stated: CR-B4-06b, R-LANDING-IMPACT basis). Units m/s
Q_LAND_FINAL_SPD,0.5
# LEGACY name of the line above (cm/s)
Q_LAND_SPEED,50
# weathervane belly into wind in QLOITER/QLAND/QRTL (CR-J1-05): wind then loads copter pitch (CL-B3-HOVER-PITCH-RATIO 8.3), fins edge-on
Q_WVANE_ENABLE,1
# weathervane gain start 1 (J1, ArduPilot weathervaning page)
Q_WVANE_GAIN,1

# ---------------------------------------------------------------- 5 Transition (TRANSITION section of SPEC.md)
# forward pitch-over rate 12 deg/s: peak thrust 0.76 on a sagged pack (CR-B1-12 supersedes CR-B1-07's 20; raise to 20 for fresh-pack flights after logs)
Q_TAILSIT_RAT_FW,12
# back-transition pitch-up rate 30 deg/s (default 50); SITL S5 sweeps 20/30/50 against B3's 1.0 N*m nose-up demand (CR-B3-04d)
Q_TAILSIT_RAT_VT,30
# plane controller takes over at 70 deg nose-down from vertical = 20 deg above the horizon: airspeed is read near zero AoA (CR-B4-06d)
Q_TAILSIT_ANGLE,70
# back-transition throttle 55 % (default -1 = hover throttle 49 %): keeps thrust and wash up in the flare (J1 failure mode 3)
Q_TAILSIT_THR_VT,55
# gain scaling on throttle only (default, stated): bit 2 (disk theory) would schedule on airspeed in the pitch-over, which B4 forbids (CR-B4-06d)
Q_TAILSIT_GSCMSK,1
# disk loading 2.6 kg / 0.245 m^2 (CR-J1-05); inert while GSCMSK bit 2 is off, set so the switch is one parameter
Q_TAILSIT_DSKLD,10.6
# copter assist below 13 m/s = 1.10 Vs (CR-B1-12)
Q_ASSIST_SPEED,13
# copter assist below 15 m above home in fixed-wing modes
Q_ASSIST_ALT,15
# transition time limit 15 s (B1 needs 7.7 s to 1.3 Vs at 12 deg/s, CL-B1-TRANS-TIME)
Q_TRANS_FAIL,15
# on transition failure: QRTL (R-FAILSAFES)
Q_TRANS_FAIL_ACT,1

# ---------------------------------------------------------------- 6 Fixed-wing envelope (B1, B3, C1)
# cruise target 16 m/s (P:performance.cruise_ms; >= 1.3 Vs 15.42, CL-A1-TRANSITION-GATE)
AIRSPEED_CRUISE,16
# TECS floor 15 m/s = 1.26 Vs (CR-B1-12; integer parameter). D-21: re-check against B3's R1 trimmed stall
AIRSPEED_MIN,15
# TECS ceiling 18 m/s (CR-B1-12; <= 20 asked by C1 CR-C1-08; manoeuvre speed VA 20.1)
AIRSPEED_MAX,18
# stall speed for stall-prevention bank scaling (CL-A1-STALL-GATE 11.86 m/s)
AIRSPEED_STALL,12
# airspeed the FW gains are tuned at = cruise
SCALING_SPEED,16
# bank limit 45 deg: n = 1.41 against the +3.0 limit (P:requirements.load_factor_limit_pos)
ROLL_LIMIT_DEG,45
# pitch limits (deg)
PTCH_LIM_MAX_DEG,20
PTCH_LIM_MIN_DEG,-15
# FW body-rate limits (deg/s) <= 172 deg/s (C1); roll >= 90 deg/s requirement (P:requirements.roll_rate_min_degs)
RLL2SRV_RMAX,150
PTCH2SRV_RMAX_UP,100
PTCH2SRV_RMAX_DN,100
# TECS climb 3 m/s (CR-B1-12; FW climb 4.7 m/s at 80 % thrust)
TECS_CLMB_MAX,3
# TECS sink 4 m/s
TECS_SINK_MAX,4
# airspeed sensor MS5525 auto-address (F3 resolves the 0x76 clash, OI-08); used in FW only
ARSPD_TYPE,3
# use the sensor for TECS and gain scaling (default 1, stated)
ARSPD_USE,1

# ---------------------------------------------------------------- 7 Fixed-wing yaw by differential thrust (CR-B3-04a, CR-J1-05)
# rudder output -> left/right motor differential, % of full output per unit rudder (default 10). Needs 28 % for 1.0 N*m (CL-F4-RUDD-DT-REQ)
RUDD_DT_GAIN,35
# yaw damper on the (virtual) rudder channel; builders 0.08-0.12 (J1)
YAW2SRV_DAMP,0.1
# no sideslip feedback until the twin's yaw doublet (T-B3-YAW-DOUBLET) shows it is needed
YAW2SRV_SLIP,0

# ---------------------------------------------------------------- 8 Vibration: harmonic notch on ESC rpm (CR-B4-06c, CR-J1-12)
INS_HNTCH_ENABLE,1
# mode 3 = ESC telemetry (bidirectional DShot)
INS_HNTCH_MODE,3
# lowest tracked fundamental 70 Hz (hover 1P 90 Hz, CL-B4-HOVER-RPM; descent throttle lower)
INS_HNTCH_FREQ,70
# bandwidth half the minimum frequency
INS_HNTCH_BW,35
# harmonics 1, 2, 3 (bitmask 7): 1P, blade pass 2P (180-311 Hz), 3P; one notch set on mean rpm (F405 CPU)
INS_HNTCH_HMNCS,7
# log raw + filtered gyro batches on tuning flights (FFT check of the notch)
INS_LOG_BAT_MASK,1
INS_LOG_BAT_OPT,4

# ---------------------------------------------------------------- 9 Battery (E2: CL-E2-BATT-LOW-MAH, CL-E2-BATT-CRT-MAH)
# analog voltage + current (power module; F1 sets BATT_VOLT_MULT and BATT_AMP_PERVLT on the bench)
BATT_MONITOR,4
# nameplate 6 500 mAh; lower to the measured capacity (T-E2-CAPACITY)
BATT_CAPACITY,6500
# low at 2 700 mAh remaining -> RTL (CR-E2-13 provisional; 2 600 when E2 re-emits the claim)
BATT_LOW_MAH,2700
# critical at 1 300 mAh = 20 % reserve -> QLAND
BATT_CRT_MAH,1300
# voltage backups 3.50 / 3.40 V per cell
BATT_LOW_VOLT,14.0
BATT_CRT_VOLT,13.6
# sag-compensated voltage for the failsafe: a transition sag must not trigger it
BATT_FS_VOLTSRC,1
# low action 1 = RTL (FW home, then QRTL landing via Q_RTL_MODE 1)
BATT_FS_LOW_ACT,1
# critical action 4 = QLAND
BATT_FS_CRT_ACT,4
# refuse to arm below 4.10 V/cell: the mAh counter assumes a full pack
BATT_ARM_VOLT,16.4

# ---------------------------------------------------------------- 10 RC link and failsafes
# RC failsafe on (default 1, stated); ELRS/CRSF loss of frames triggers it
THR_FAILSAFE,1
# short failsafe in FW: 0 = continue in AUTO/GUIDED, else circle; Q modes go to QLAND (Q_OPTIONS bit 5 off)
FS_SHORT_ACTN,0
# long failsafe in FW: 1 = RTL
FS_LONG_ACTN,1
# long failsafe after 5 s (default, stated)
FS_LONG_TIMEOUT,5
# RTL: fly home fixed-wing, then back-transition and land vertically
Q_RTL_MODE,1
# RTL cruise altitude 50 m (>= transition altitude, P:requirements.transition_alt_min_m)
RTL_ALTITUDE,50
# QRTL / VTOL approach altitude 30 m
Q_RTL_ALT,30
# loiter radius at home 60 m (turn radius at 16 m/s, 45 deg bank = 26 m)
RTL_RADIUS,60
WP_LOITER_RAD,60
# EKF failsafe threshold (default 0.8, stated); in Q modes it lands (QLAND), GPS loss lands without position hold
FS_EKF_THRESH,0.8
# flight-mode channel 5; positions set with F5 on the transmitter
FLTMODE_CH,5
# QSTABILIZE
FLTMODE1,17
# QHOVER
FLTMODE2,18
# QLOITER
FLTMODE3,19
# FBWA (forward transition is started by entering it)
FLTMODE4,5
# CRUISE (heading + altitude hold, airspeed by TECS)
FLTMODE5,7
# RTL
FLTMODE6,11
# arm/disarm switch on channel 8 (R-ARM-KILL); rudder-stick arming off
RC8_OPTION,153
ARMING_RUDDER,0
# emergency motor stop on channel 9 (R-ARM-KILL, <= 1 s; SITL S13 times it)
RC9_OPTION,31

# ---------------------------------------------------------------- 11 Geofence (RFS, P17)
FENCE_ENABLE,1
# 3 = max altitude + home circle; 7 once the sub-field polygon is uploaded (H3 provides the corners)
FENCE_TYPE,3
# breach action 1 = RTL (in a Q mode: SITL S9 records what the build does)
FENCE_ACTION,1
# 110 m AGL against 400 ft = 121.9 m (P:mission.ceiling_ft_agl)
FENCE_ALT_MAX,110
# 250 m circle around home, inside VLOS 500 m (P:requirements.vlos_max_m)
FENCE_RADIUS,250
FENCE_MARGIN,10
