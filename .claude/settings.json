{
  "hooks": {
    "PreCompact": [
      { "hooks": [ { "type": "command", "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/recovery.py\" pre-compact", "timeout": 30 } ] }
    ],
    "PostCompact": [
      { "hooks": [ { "type": "command", "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/recovery.py\" post-compact", "timeout": 30 } ] }
    ],
    "SessionStart": [
      { "matcher": "startup|resume|compact|clear",
        "hooks": [ { "type": "command", "command": "python -I \"$CLAUDE_PROJECT_DIR/.claude/hooks/recovery.py\" session-start", "timeout": 30 } ] }
    ]
  }
}
